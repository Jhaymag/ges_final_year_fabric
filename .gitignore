# ── Generated crypto material (regenerated by setup-ges-network.sh) ───────
crypto-config/

# ── Generated channel artifacts ───────────────────────────────────────────
channel-artifacts/
geschannel.block

# ── Chaincode runtime files ───────────────────────────────────────────────
# chaincode.env is written by deploy-chaincode.sh on each install.
# The CHAINCODE_ID inside it changes every time — do not commit.
chaincode.env

# ── Compiled chaincode binary ─────────────────────────────────────────────
chaincode/ges-verify/ges-verify
*.tar.gz

# ── Ledger data (Docker volumes) ──────────────────────────────────────────
ledger-data/

# ── Private keys (never commit these) ────────────────────────────────────
*_sk
priv_sk
*.key

# ── OS / editor junk ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.env
*.swp
